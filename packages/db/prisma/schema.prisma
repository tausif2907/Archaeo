generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum RepoStatus {
  queued
  ingesting
  ready
  failed
}

enum SymbolKind {
  function
  class
  method
}

enum EdgeKind {
  import
  call
}

enum ChunkSource {
  code
  commit
  pr
}

enum AgentRunKind {
  chat
  trace
  fix
}

enum AgentRunStatus {
  running
  succeeded
  failed
  limited
}

model Repo {
  id             String     @id @default(cuid())
  url            String     @unique
  owner          String
  name           String
  defaultBranch  String?
  language       String?
  status         RepoStatus @default(queued)
  /// Current ingest stage: clone | parse | history | embed | summarize | done
  stage          String?
  statusMessage  String?
  headSha        String?
  /// Last successful GitHub PR/issue fetch; later fetches only ask for newer updates
  githubSyncedAt DateTime?
  /// Era generation: pending | running | ready | failed
  erasStatus     String?
  erasMessage    String?
  /// Sandbox overrides (test command, install steps); detected from the repo when null
  sandboxConfig  Json?
  /// Free-form counters, e.g. { files, symbols, commits, prs, loc }
  stats          Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  files        File[]
  edges        Edge[]
  commits      Commit[]
  pullRequests PullRequest[]
  issues       Issue[]
  eras         Era[]
  modules      Module[]
  chunks       Chunk[]
  agentRuns    AgentRun[]
}

model File {
  id         String   @id @default(cuid())
  repoId     String
  path       String
  language   String?
  /// Content hash, used to skip unchanged files on re-ingest
  hash       String?
  loc        Int      @default(0)
  summary    String?
  complexity Int      @default(0)
  churn      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  repo     Repo     @relation(fields: [repoId], references: [id], onDelete: Cascade)
  symbols  Symbol[]
  outEdges Edge[]   @relation("EdgeFromFile")
  inEdges  Edge[]   @relation("EdgeToFile")

  @@unique([repoId, path])
}

model Symbol {
  id            String     @id @default(cuid())
  fileId        String
  kind          SymbolKind
  name          String
  /// Dotted path within the file, e.g. `Command.invoke`
  qualifiedName String
  startLine     Int
  endLine       Int
  summary       String?

  file     File   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  outEdges Edge[] @relation("EdgeFromSymbol")
  inEdges  Edge[] @relation("EdgeToSymbol")

  @@index([fileId])
  @@index([name])
}

model Edge {
  id           String   @id @default(cuid())
  repoId       String
  kind         EdgeKind
  fromFileId   String?
  toFileId     String?
  fromSymbolId String?
  toSymbolId   String?

  repo       Repo    @relation(fields: [repoId], references: [id], onDelete: Cascade)
  fromFile   File?   @relation("EdgeFromFile", fields: [fromFileId], references: [id], onDelete: Cascade)
  toFile     File?   @relation("EdgeToFile", fields: [toFileId], references: [id], onDelete: Cascade)
  fromSymbol Symbol? @relation("EdgeFromSymbol", fields: [fromSymbolId], references: [id], onDelete: Cascade)
  toSymbol   Symbol? @relation("EdgeToSymbol", fields: [toSymbolId], references: [id], onDelete: Cascade)

  @@index([repoId, kind])
  @@index([fromFileId])
  @@index([toFileId])
  @@index([fromSymbolId])
  @@index([toSymbolId])
}

model Commit {
  id           String   @id @default(cuid())
  repoId       String
  sha          String
  author       String
  date         DateTime
  message      String
  /// [{ path, additions, deletions }]
  filesChanged Json?
  summary      String?

  repo Repo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, sha])
  @@index([repoId, date])
}

model PullRequest {
  id               String    @id @default(cuid())
  repoId           String
  number           Int
  title            String
  body             String?
  mergedAt         DateTime?
  mergeCommitSha   String?
  /// Merge/squash commit plus every commit from the PR branch
  linkedCommitShas String[]

  repo Repo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, number])
}

model Issue {
  id     String   @id @default(cuid())
  repoId String
  number Int
  title  String
  body   String?
  state  String
  labels String[]

  repo Repo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, number])
}

model Era {
  id            String   @id @default(cuid())
  repoId        String
  title         String
  startDate     DateTime
  endDate       DateTime
  narrative     String?
  keyCommitShas String[]
  keyPrNumbers  Int[]
  /// { commits, contributors, topAreas, topAuthors, releases }
  stats         Json?
  /// Hash of the era's boundaries and key items; narratives are reused while it is unchanged
  fingerprint   String?

  repo Repo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([repoId, startDate])
}

model Module {
  id          String  @id @default(cuid())
  repoId      String
  path        String
  summary     String?
  parentPath  String?
  /// Hash of the child summaries this summary was written from
  fingerprint String?

  repo Repo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, path])
}

model Chunk {
  id         String                       @id @default(cuid())
  repoId     String
  sourceType ChunkSource
  sourceId   String
  /// For code chunks: the cited range (`path:startLine-endLine`)
  path       String?
  startLine  Int?
  endLine    Int?
  text       String
  /// Dimension must match EMBED_DIM (packages/models config). Changing it needs a migration.
  embedding  Unsupported("vector(1024)")?

  repo Repo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([repoId, sourceType])
  @@index([repoId, path])
  @@index([sourceId])
}

model AgentRun {
  id           String         @id @default(cuid())
  repoId       String
  kind         AgentRunKind
  input        Json
  status       AgentRunStatus @default(running)
  toolCalls    Json?
  /// Final answer and citations
  output       Json?
  costEstimate Float          @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  /// For fix runs: the trace run whose report is being fixed
  parentRunId String?

  repo        Repo         @relation(fields: [repoId], references: [id], onDelete: Cascade)
  fixAttempts FixAttempt[]
  modelCalls  ModelCall[]

  @@index([repoId, kind, createdAt])
  @@index([parentRunId])
}

model FixAttempt {
  id             String    @id @default(cuid())
  runId          String
  attempt        Int       @default(1)
  baseSha        String?
  patch          String
  applied        Boolean   @default(false)
  applyError     String?
  testOutput     String?
  testSummary    String?
  /// Tests failing with the patch that passed at the base commit
  newFailures    String[]
  passed         Boolean   @default(false)
  /// The patch adds or changes tests
  regressionTest Boolean   @default(false)
  /// Those tests fail without the fix (null when not checked)
  reproduced     Boolean?
  durationMs     Int?
  approvedAt     DateTime?
  branch         String?
  prUrl          String?
  createdAt      DateTime  @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model ModelCall {
  id        String   @id @default(cuid())
  runId     String?
  task      String
  model     String
  tokensIn  Int
  tokensOut Int
  latencyMs Int
  cost      Float
  createdAt DateTime @default(now())

  run AgentRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([task])
}
