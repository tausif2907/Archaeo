# --- Infrastructure (docker compose) ---
POSTGRES_PORT=5442
REDIS_PORT=6389
DATABASE_URL=postgresql://archaeo:archaeo@localhost:5442/archaeo
REDIS_URL=redis://localhost:6389

# --- Services ---
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Where cloned repos are stored (relative to repo root or absolute)
WORKSPACE_DIR=.workspace

# --- Ingest limits ---
INGEST_MAX_LOC=200000
INGEST_MAX_COMMITS=20000
INGEST_MAX_PRS=3000
INGEST_MAX_ISSUES=3000
# Only the N most recent commits get an LLM summary
SUMMARIZE_MAX_COMMITS=1000
SUMMARIZE_BATCH_SIZE=25
EMBED_BATCH_SIZE=64

# --- Agent run limits (per question) ---
AGENT_MAX_TOOL_CALLS=10
AGENT_MAX_SECONDS=90
AGENT_MAX_COST_USD=0.5

# --- GitHub ---
# Optional but recommended: unauthenticated requests are limited to 60/hour.
# Publishing approved fixes also needs permission to fork repos and open pull requests.
GITHUB_TOKEN=
# Where approved fixes open their PR: "fork" (inside your fork, default) or "upstream"
PR_TARGET=fork
# Commit author for published fixes (defaults to the token's GitHub user and noreply email)
PR_AUTHOR_NAME=
PR_AUTHOR_EMAIL=

# --- Models (see packages/models/src/config.ts) ---
# "mock" runs everything offline with canned outputs; "live" calls the real APIs.
MODEL_PROVIDER=mock
# Meta Model API (Muse Spark), from dev.meta.ai. Meta's docs call this key MODEL_API_KEY; either name works.
META_API_KEY=
# Defaults to https://api.meta.ai/v1
META_API_BASE_URL=
# Host for summarizeCheap (Muse Spark Open): "baseten" (default) or "fireworks"
OPENWEIGHTS_PROVIDER=baseten
# Host for embed (the Meta Model API has no embedding model): "fireworks" (default) or "baseten"
EMBED_PROVIDER=fireworks
BASETEN_API_KEY=
# Defaults to https://inference.baseten.co/v1
BASETEN_BASE_URL=
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
# Model IDs. Leave blank for the defaults: muse-spark-1.3 (reason and write code), meta-models/muse-spark-open
# (summarize), muse-image-1.0 (image), accounts/fireworks/models/qwen3-embedding-0p6b (embed, 1,024 dimensions).
MODEL_REASON=
MODEL_WRITE_CODE=
MODEL_SUMMARIZE=
MODEL_IMAGE=
MODEL_EMBED=
EMBED_DIM=1024
# Seconds before a model call times out (Muse Spark reasons before answering)
MODEL_TIMEOUT_SECONDS=120
# USD per 1M tokens by model ID, as one line of JSON. Meta's Muse Spark and Muse Wonder prices are built in;
# add the Baseten and Fireworks models here, or their calls count as $0.
# Example: {"meta-models/muse-spark-open":{"inputPerM":1.25,"outputPerM":4.25}}
MODEL_PRICING=

# --- Sandbox / fixer ---
# "docker" (default, local containers) or "modal" (not implemented yet)
SANDBOX_PROVIDER=docker
SANDBOX_TIMEOUT_SECONDS=600
FIX_MAX_ATTEMPTS=3
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
