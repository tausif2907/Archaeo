# --- Infrastructure (docker compose) ---
POSTGRES_PORT=5442
REDIS_PORT=6389
DATABASE_URL=postgresql://archaeo:archaeo@localhost:5442/archaeo
REDIS_URL=redis://localhost:6389

# --- Services ---
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Where cloned repos are stored (relative to repo root or absolute)
WORKSPACE_DIR=.workspace

# --- Ingest limits ---
INGEST_MAX_LOC=200000
INGEST_MAX_COMMITS=20000
INGEST_MAX_PRS=3000
INGEST_MAX_ISSUES=3000
# Only the N most recent commits get an LLM summary
SUMMARIZE_MAX_COMMITS=1000
SUMMARIZE_BATCH_SIZE=25
EMBED_BATCH_SIZE=64

# --- GitHub ---
# Optional but recommended: unauthenticated requests are limited to 60/hour
GITHUB_TOKEN=

# --- Models (see packages/models/src/config.ts) ---
# "mock" runs everything offline with canned outputs; "live" calls the real APIs.
MODEL_PROVIDER=mock
META_API_KEY=
META_API_BASE_URL=
# Open-weights host for summarizeCheap / embed: "baseten" | "fireworks"
OPENWEIGHTS_PROVIDER=fireworks
BASETEN_API_KEY=
BASETEN_BASE_URL=
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
# Model IDs: TBD at kickoff. Leave blank to use the placeholders in config.ts.
MODEL_REASON=
MODEL_WRITE_CODE=
MODEL_SUMMARIZE=
MODEL_IMAGE=
MODEL_EMBED=
EMBED_DIM=1024

# --- Sandbox ---
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
