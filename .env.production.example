# Copy to .env.production on the server and fill in. Used by docker-compose.prod.yml, both for its own
# variables and as the environment of the api, worker and web containers.

# --- Deployment ---
# A domain pointing at this server gets automatic HTTPS. ":80" serves plain HTTP (local test, or behind another proxy).
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443
# Same origin as the site, e.g. https://archaeo.example.com (http://localhost when SITE_ADDRESS=:80)
WEB_ORIGIN=http://localhost
POSTGRES_PASSWORD=change-me
# Host folder for clones and sandbox checkouts, mounted at the same path inside the containers
ARCHAEO_DATA=/srv/archaeo
# "true" for a public link: visitors explore the pre-ingested repos; adding, re-ingesting, regenerating eras
# and publishing pull requests are turned off. Pre-ingest with `pnpm demo:prepare` (see README, Deploy).
PUBLIC_DEMO=true

# --- GitHub ---
# Read-only access is enough for a public demo (raises the API rate limit for ingest and issue URLs).
GITHUB_TOKEN=

# --- Models (see .env.example for every option) ---
MODEL_PROVIDER=live
# Muse Spark on the Meta Model API; Muse Spark Open on Baseten; embeddings on Fireworks
META_API_KEY=
BASETEN_API_KEY=
FIREWORKS_API_KEY=
OPENWEIGHTS_PROVIDER=baseten
EMBED_PROVIDER=fireworks
# Blank model IDs use the defaults in packages/models/src/config.ts
MODEL_REASON=
MODEL_WRITE_CODE=
MODEL_SUMMARIZE=
MODEL_IMAGE=
MODEL_EMBED=
EMBED_DIM=1024
MODEL_TIMEOUT_SECONDS=120
# Meta's prices are built in; add the Baseten and Fireworks models, e.g.
# {"meta-models/muse-spark-open":{"inputPerM":1.25,"outputPerM":4.25}}
MODEL_PRICING=

# --- Limits for a public link ---
AGENT_MAX_TOOL_CALLS=10
AGENT_MAX_SECONDS=90
AGENT_MAX_COST_USD=0.25
SANDBOX_PROVIDER=docker
SANDBOX_TIMEOUT_SECONDS=600
FIX_MAX_ATTEMPTS=3
