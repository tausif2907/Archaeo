{
  "name": "archaeo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @archaeo/web --filter @archaeo/api --filter @archaeo/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @archaeo/db generate",
    "db:migrate": "pnpm --filter @archaeo/db migrate:dev",
    "db:deploy": "pnpm --filter @archaeo/db migrate:deploy",
    "postinstall": "pnpm --filter @archaeo/db generate",
    "eval": "pnpm --filter @archaeo/evals eval",
    "demo:prepare": "pnpm --filter @archaeo/worker demo:prepare",
    "models:check": "pnpm --filter @archaeo/worker models:check",
    "eval:history": "pnpm --filter @archaeo/evals history",
    "check:citations": "pnpm --filter @archaeo/evals check:citations",
    "eval:qa": "pnpm --filter @archaeo/evals qa",
    "e2e": "pnpm --filter @archaeo/web e2e",
    "eval:bugs": "pnpm --filter @archaeo/evals bugs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "1.49.1",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "tree-sitter",
      "tree-sitter-python",
      "tree-sitter-typescript"
    ]
  }
}
